# ------------------------------------------------------------------
# Prescrip backend environment variables (copy to .env, fill real values)
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# Server
PORT=4000
BACKEND_URL=http://localhost:4000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/prescrip

# JWT
JWT_SECRET=change_this_to_a_long_random_secret

# Cloudinary (image uploads: patient avatars + doctor photos)
# Leave blank to fall back to local disk storage under /uploads
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Admin credentials (admin is authenticated from env, not the DB)
ADMIN_EMAIL=admin@prescrip.com
ADMIN_PASSWORD=change_this_admin_password

# ------------------------------------------------------------------
# Payments.  Three methods: card (Razorpay) | easypaisa | jazzcash
#
# PAYMENT_DEMO=true  -> every method is simulated locally (no keys needed),
#                       for testing the full payment flow offline.
# PAYMENT_DEMO=false -> a method is only offered when its keys are present.
# ------------------------------------------------------------------
PAYMENT_DEMO=true
PAYMENT_CURRENCY=PKR

# --- Card / Wallet (Razorpay) ---
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# --- Easypaisa (Pakistan) ---
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENDPOINT=

# --- JazzCash (Pakistan) ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=
