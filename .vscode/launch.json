{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend API (node :4000)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "envFile": "${workspaceFolder}/backend/.env"
    },
    {
      "name": "Frontend: patient site (Chrome :5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "Admin panel (Chrome :5174)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174/admin/login",
      "webRoot": "${workspaceFolder}/admin/src"
    },
    {
      "name": "Doctor panel (Chrome :5174)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174/doctor/login",
      "webRoot": "${workspaceFolder}/admin/src"
    },
    {
      "name": "Unified portal (Chrome :4000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4000/portal",
      "webRoot": "${workspaceFolder}/portal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: API + patient + admin",
      "configurations": [
        "Backend API (node :4000)",
        "Frontend: patient site (Chrome :5173)",
        "Admin panel (Chrome :5174)"
      ],
      "stopAll": true
    }
  ]
}
